# Copier en .env (jamais versionné) et remplir.
# En dev, .env est lu à la racine du projet ; une fois l'app packagée, dans le dossier userData.

# Token warframe.market : uniquement pour Vendre / Retirer en réel. Reste dans le process main.
WFM_JWT=remplace-moi-par-ton-token

# Python + script OCR (bouton "Scanner AlecaFrame")
PYTHON_PATH=C:\Users\ton-user\AppData\Local\Programs\Python\Python311\python.exe
OCR_SCRIPT=D:\chemin\vers\warframeMarketTool\ocrRiven\ocrRiven.py

# Optionnel : emplacement de rivens.json (price_history.json est créé dans le même dossier)
RIVENS_JSON=D:\chemin\vers\warframeMarketTool\rivens.json

# Optionnel : script finderBot (bouton "Calculer les prix"). Par défaut : finderBot.py dans le dossier de OCR_SCRIPT
FINDER_SCRIPT=D:\chemin\vers\warframeMarketTool\ocrRiven\finderBot.py

# Import AlecaFrame (bouton "Importer depuis AlecaFrame") – tout est optionnel, trouvé automatiquement sinon
# Pseudo warframe.market pour retrouver tes annonces (par défaut : lastUsername.txt d'AlecaFrame)
WFM_USERNAME=ton-pseudo
# ALECAFRAME_DIR=C:\Users\ton-user\AppData\Local\AlecaFrame
# ALECAFRAME_DLL=C:\Users\ton-user\AppData\Local\Overwolf\Extensions\...\NET\AlecaFrameClientLib.dll
