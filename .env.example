# Copier en .env (jamais versionné) ou, plus simple, régler tout ça dans l'app : ⚙ Paramètres.
# En dev, .env est lu à la racine du projet ; une fois l'app installée, dans le dossier userData
# (%APPDATA%\warframe-market-tool\.env, le chemin exact est affiché dans ⚙ Paramètres).

# Token warframe.market (cookie "JWT") : seulement pour Vendre / Retirer en réel. Reste dans le process main.
WFM_JWT=remplace-moi-par-ton-token

# Optionnel : pseudo warframe.market (par défaut : celui mémorisé par AlecaFrame)
WFM_USERNAME=ton-pseudo

# Optionnel : emplacement de rivens.json (price_history.json et notif_state.json sont créés dans le même dossier)
RIVENS_JSON=D:\chemin\vers\rivens.json

# Optionnel : AlecaFrame installé ailleurs que %LOCALAPPDATA%\AlecaFrame / extension Overwolf
# ALECAFRAME_DIR=C:\Users\ton-user\AppData\Local\AlecaFrame
# ALECAFRAME_DLL=C:\Users\ton-user\AppData\Local\Overwolf\Extensions\...\NET\AlecaFrameClientLib.dll

# Automatisation (1 = activé, 0 = désactivé ; activé par défaut)
AUTO_DAILY=1
NOTIFY=1
